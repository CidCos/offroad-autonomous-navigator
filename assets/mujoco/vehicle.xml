<mujoco model="offroad_vehicle">
  <option gravity="0 0 -9.81" timestep="0.002"/>

  <default>
    <joint damping="0.5"/>
    <geom friction="1.0 0.1 0.1" contype="1" conaffinity="1"/>
  </default>

  <worldbody>
    <light pos="0 0 5" dir="0 0 -1" diffuse="1 1 1"/>
    <geom name="ground" type="plane" size="20 20 0.1" rgba="0.55 0.45 0.35 1"/>

    <body name="chassis" pos="0 0 0.3">
      <freejoint/>
      <geom name="chassis_geom" type="box" size="0.3 0.2 0.1" rgba="0.2 0.4 0.8 1" mass="5"/>

      <!-- Front left wheel: steering joint + rolling joint -->
      <body name="steer_fl" pos="0.25 0.22 -0.1">
        <joint name="steer_fl_joint" type="hinge" axis="0 0 1" range="-0.5 0.5"/>
        <inertial pos="0 0 0" mass="0.1" diaginertia="0.001 0.001 0.001"/>
        <body name="wheel_fl" pos="0 0 0">
          <joint name="wheel_fl_joint" type="hinge" axis="0 1 0"/>
          <geom name="wheel_fl_geom" type="cylinder" size="0.12 0.05" euler="90 0 0"
                rgba="0.1 0.1 0.1 1" mass="1"/>
        </body>
      </body>

      <!-- Front right wheel: steering joint + rolling joint -->
      <body name="steer_fr" pos="0.25 -0.22 -0.1">
        <joint name="steer_fr_joint" type="hinge" axis="0 0 1" range="-0.5 0.5"/>
        <inertial pos="0 0 0" mass="0.1" diaginertia="0.001 0.001 0.001"/>
        <body name="wheel_fr" pos="0 0 0">
          <joint name="wheel_fr_joint" type="hinge" axis="0 1 0"/>
          <geom name="wheel_fr_geom" type="cylinder" size="0.12 0.05" euler="90 0 0"
                rgba="0.1 0.1 0.1 1" mass="1"/>
        </body>
      </body>

      <!-- Rear left wheel: rolling joint only -->
      <body name="wheel_rl" pos="-0.25 0.22 -0.1">
        <joint name="wheel_rl_joint" type="hinge" axis="0 1 0"/>
        <geom name="wheel_rl_geom" type="cylinder" size="0.12 0.05" euler="90 0 0"
              rgba="0.1 0.1 0.1 1" mass="1"/>
      </body>

      <!-- Rear right wheel: rolling joint only -->
      <body name="wheel_rr" pos="-0.25 -0.22 -0.1">
        <joint name="wheel_rr_joint" type="hinge" axis="0 1 0"/>
        <geom name="wheel_rr_geom" type="cylinder" size="0.12 0.05" euler="90 0 0"
              rgba="0.1 0.1 0.1 1" mass="1"/>
      </body>
    </body>
  </worldbody>

  <!-- Couple both steering joints to move together (Ackermann simplification) -->
  <equality>
    <joint joint1="steer_fl_joint" joint2="steer_fr_joint" polycoef="0 1 0 0 0"/>
  </equality>

  <!-- Actuators: what your RL policy actually controls -->
  <actuator>
    <position name="steering" joint="steer_fl_joint" kp="20" kv="2" ctrlrange="-0.5 0.5"/>
    <velocity name="propulsion_rl" joint="wheel_rl_joint" kv="5" ctrlrange="-20 20"/>
    <velocity name="propulsion_rr" joint="wheel_rr_joint" kv="5" ctrlrange="-20 20"/>
  </actuator>
</mujoco>